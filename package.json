{
  "name": "calculator",
  "version": "1.0.5",
  "description": "全能计算器 - PC端",
  "author": "鲲穹AI",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5175 && electron .\"",
    "electron:build": "vite build && electron-builder --win --config",
    "test:auth": "tsx src/__tests__/auth.test.ts"
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "lunar-javascript": "^1.7.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0",
    "relationship.js": "^1.2.7",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "png-to-ico": "^3.0.1",
    "sass": "^1.97.3",
    "sharp": "^0.34.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.calculator",
    "productName": "全能计算器",
    "directories": {
      "output": "release_1.0.5"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/计算器.ico"
    ],
    "extraResources": [
      {
        "from": "public/计算器.ico",
        "to": "计算器.ico"
      }
    ],
    "extraFiles": [
      {
        "from": "updater.exe",
        "to": "."
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/计算器.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "全能计算器",
      "artifactName": "全能计算器-安装版-${version}.${ext}"
    },
    "portable": {
      "artifactName": "全能计算器-便携版.${ext}"
    }
  }
}
